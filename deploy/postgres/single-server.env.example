# Public values only. Blank required values deliberately prevent deployment.
# Keep separate from production.env: the existing validator rejects extra keys.
# Reviewed official postgres:17-bookworm (or 17.x-bookworm) image @sha256:digest.
POSTGRES_IMAGE=
KINETRA_POSTGRES_DATA_DIR=
KINETRA_POSTGRES_CA_FILE=
KINETRA_POSTGRES_CERT_FILE=
KINETRA_POSTGRES_KEY_FILE=
KINETRA_POSTGRES_SECRETS_DIR=
# Operator-created public config outside the checkout; see IP_HTTPS_DEPLOYMENT.md.
# Must contain only the validated nginx-real-ip.conf for the observed edge peer.
KINETRA_EDGE_CONFIG_DIR=

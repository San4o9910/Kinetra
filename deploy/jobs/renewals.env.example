# Dedicated renewals credentials. Never copy the API environment here.
# Deferred launch: do not schedule or start this worker. Its parser refuses false.
# API and renewal job read their own PAYMENTS_ENABLED; neither config sets the other.
NODE_ENV=production
DATABASE_URL=postgresql://kinetra_job:REPLACE_SECRET@database.example.invalid:5432/kinetra?sslmode=verify-full
PAYMENTS_ENABLED=false
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_REQUEST_TIMEOUT_MS=10000

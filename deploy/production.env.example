# Public deployment metadata only. Values below deliberately fail validation.
NODE_IMAGE=REPLACE_WITH_node_bookworm_slim_IMAGE_AT_sha256_DIGEST
NGINX_IMAGE=REPLACE_WITH_nginx_unprivileged_1_30_4_alpine_slim_IMAGE_AT_sha256_DIGEST
BACKEND_IMAGE=REPLACE_WITH_REVIEWED_BACKEND_IMAGE_AT_sha256_DIGEST
FRONTEND_IMAGE=REPLACE_WITH_REVIEWED_FRONTEND_IMAGE_AT_sha256_DIGEST
VCS_REF=REPLACE_WITH_FULL_REVIEWED_COMMIT_SHA
VITE_API_URL=https://api.example.invalid
VITE_PRIVATE_MEDIA_ORIGIN=
KINETRA_API_ENV_FILE=/absolute/approved/kinetra/api.env
# Encrypted, dedicated, pre-created scratch directory; owner UID 1000, mode 0700.
# Required only when executing video-verify. Do not use a shared /tmp directory.
KINETRA_VIDEO_SCRATCH_DIR=/absolute/approved/encrypted/kinetra-video-scratch

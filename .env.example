# -----------------------------------------------------------------------------
# Kinetra local environment
# Copy this file to .env. These are development placeholders, not production secrets.
# -----------------------------------------------------------------------------

# Frontend
# Exact API origin only. Blank uses the local :3000 fallback; production must set HTTPS explicitly.
VITE_API_URL=
VITE_APP_VERSION=0.4.0
VITE_PRIVACY_URL=https://kinetra.app/privacy
VITE_SUPPORT_EMAIL=coach@kinetra.app
# Exact public origin used by private signed chat/base-lesson media URLs. No path or wildcard.
# Keep blank while private media is disabled; production must use HTTPS.
VITE_PRIVATE_MEDIA_ORIGIN=

# Backend
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Set to the exact number of trusted reverse proxies in production; keep 0 locally.
TRUST_PROXY_HOPS=0
# Readiness is private DB connectivity; migration state is checked separately before traffic.
READINESS_TIMEOUT_MS=2000
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000

# PostgreSQL / Docker Compose
# Production requires an explicit non-local URL with non-default credentials and
# exactly one sslmode=require or verify-full (certificate verification recommended).
POSTGRES_DB=kinetra
POSTGRES_USER=kinetra
POSTGRES_PASSWORD=kinetra_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kinetra:kinetra_local_only@localhost:5432/kinetra

# Access JWT. Replace with at least 32 random bytes before deployment.
JWT_ACCESS_SECRET=local-development-only-change-this-kinetra-access-secret-2026
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=kinetra-backend
JWT_AUDIENCE=kinetra-pwa

# Password and refresh-session policy
AUTH_BCRYPT_COST=12
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=kinetra_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax

# Phone is an optional alternative identifier. Phone-only registration is off by default.
# Phone numbers are accepted and stored in normalized E.164 form, for example +79991234567.
AUTH_PHONE_LOGIN_ENABLED=true
AUTH_PHONE_ONLY_REGISTRATION_ENABLED=false

# Email verification is optional for T02. When enabled, registration sends a one-time token.
AUTH_EMAIL_VERIFICATION_REQUIRED=false
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440

# Password reset
AUTH_PASSWORD_RESET_TTL_MINUTES=15
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5

# Production requires working webhook or SMTP delivery and secure refresh cookies.
# SMTP supports Yandex/Gmail email; SMS requires your own webhook receiver.
# console is permitted only outside production and prints one-time tokens for local testing.
AUTH_TOKEN_DELIVERY_MODE=console
# Required when mode=webhook: HTTPS URL without credentials/query/fragment, secret32..512 ASCII.
AUTH_TOKEN_DELIVERY_WEBHOOK_URL=
AUTH_TOKEN_DELIVERY_WEBHOOK_SECRET=
# When mode=smtp, leave webhook values empty and configure all four SMTP fields.
# Service is yandex or gmail. Use a Mail app password, never the account password.
AUTH_TOKEN_DELIVERY_SMTP_SERVICE=
AUTH_TOKEN_DELIVERY_SMTP_USERNAME=
AUTH_TOKEN_DELIVERY_SMTP_PASSWORD=
# Exact public HTTPS origin also listed in CORS_ORIGIN.
AUTH_TOKEN_DELIVERY_APP_ORIGIN=
AUTH_TOKEN_DELIVERY_TIMEOUT_MS=10000

# Optional S3-compatible storage. Leave credentials blank to return null media URLs.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_TTL_SECONDS=900

# T14 trainer video administration. Keep disabled until private multipart S3,
# ffprobe and both scheduled workers are configured and their heartbeats are fresh.
TRAINER_VIDEO_UPLOADS_ENABLED=false
VIDEO_UPLOAD_MAX_BYTES=2147483648
VIDEO_UPLOAD_PART_SIZE_BYTES=16777216
VIDEO_UPLOAD_PART_URL_TTL_SECONDS=900
VIDEO_UPLOAD_SESSION_TTL_SECONDS=21600
VIDEO_UPLOAD_MAX_ACTIVE_PER_TRAINER=3
VIDEO_VERIFY_FFPROBE_PATH=ffprobe
VIDEO_VERIFY_LEASE_SECONDS=300
VIDEO_VERIFY_DEADLINE_SECONDS=900
VIDEO_VERIFY_MAX_ATTEMPTS=8
VIDEO_WORKER_MAX_STALE_SECONDS=300
VIDEO_MEDIA_DELETE_GRACE_SECONDS=86400
VIDEO_S3_SERVER_SIDE_ENCRYPTION=AES256
VIDEO_S3_KMS_KEY_ID=

# Built-in trainer chat is opt-in. Enable photos only with a private S3 bucket and the
# scheduled chat media-cleanup worker. Production rollout remains disabled by default.
CHAT_ENABLED=false
CHAT_PHOTO_UPLOADS_ENABLED=false
# Application-level multipart deadlines. Idle must be 1-30 seconds, total 10-120 seconds,
# and idle must be strictly less than total. Ingress timeouts remain defense in depth.
CHAT_PHOTO_UPLOAD_IDLE_TIMEOUT_SECONDS=15
CHAT_PHOTO_UPLOAD_TOTAL_TIMEOUT_SECONDS=120
CHAT_MEDIA_URL_TTL_SECONDS=300

# YooKassa REST API credentials. Keep the secret server-side and rotate it if exposed.
# Defaults to true for existing installations. Set false to defer payments, leave both
# provider credentials empty and disable the separately configured renewal job.
# This flag does not grant training access or change existing subscription status.
# YUKASSA_RETURN_URL is an allowlist (comma-separated) of exact payment success URLs.
# Local HTTP is accepted only for localhost/127.0.0.1; production values must use HTTPS.
PAYMENTS_ENABLED=true
# Separate, explicit free-beta access for the first 15 eligible trainees.
# Set PAYMENTS_ENABLED=false before enabling. Does not alter subscriptions.
FREE_BETA_ENABLED=false
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_RETURN_URL=http://localhost:5173/payment/success
YUKASSA_REQUEST_TIMEOUT_MS=10000

# Web Push VAPID configuration. Generate a dedicated production pair and keep the private key
# server-side. The public key is returned to authenticated clients by the backend.
# Example subject after both keys are configured: mailto:coach@kinetra.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
